      },
      "platform": "linux/amd64",
      "pull_policy": "never",
      "build": {
        "context": ".",
        "dockerfile": "docker/Dockerfile",
        "target": "xpra-gateway",
        "args": {
          "ODYSAFE_UID": "1000",
          "ODYSAFE_GID": "1000"
        }
