{
  "name": "odysafe-distribution",
  "services": {
    "app": {
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "cpus": 1,
      "command": [
        "python",
        "-m",
        "uvicorn",
        "app.web.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8080",
        "--no-access-log"
      ],
      "entrypoint": null,
      "environment": {
        "ODYSAFE_CONTROLLER_TOKEN": "${ODYSAFE_INSTALL_TOKEN:?Set ODYSAFE_INSTALL_TOKEN in your configuration file}",
        "ODYSAFE_CONTROLLER_URL": "http://controller-gateway:8765",
        "ODYSAFE_COOKIE_SECURE": "1",
        "ODYSAFE_DB_PATH": "/database/odysafe.db",
        "ODYSAFE_DNS_WORKER_TOKEN": "${ODYSAFE_INSTALL_TOKEN:?Set ODYSAFE_INSTALL_TOKEN in your configuration file}",
        "ODYSAFE_DNS_WORKER_URL": "http://dns-enrichment:8053/v1/query",
        "ODYSAFE_INTERNET_CONTROLLER_URL": "http://controller-gateway-internet:8765",
        "ODYSAFE_PUBLIC_CAPTURE": "true",
        "ODYSAFE_WEB_BIND": "127.0.0.1",
        "ODYSAFE_WEB_ORIGINS": "https://127.0.0.1:${ODYSAFE_WEB_PORT:-8443},https://localhost:${ODYSAFE_WEB_PORT:-8443}",
        "ODYSAFE_XPRA_INTERNET_URL": "https://127.0.0.1:${ODYSAFE_XPRA_INTERNET_PORT:-14501}",
        "ODYSAFE_XPRA_URL": "https://127.0.0.1:${ODYSAFE_XPRA_PORT:-14500}"
      },
      "image": "odysafe-source-app:0.1.0",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "1073741824",
      "networks": {
        "dns-control": null,
        "web-control": null
      },
      "pids_limit": 256,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true",
        "apparmor=docker-default"
      ],
      "stop_grace_period": "45s",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=256m",
        "/home/odysafe:rw,nosuid,nodev,size=64m,uid=1000,gid=1000",
        "/run:rw,nosuid,nodev,size=64m,uid=1000,gid=1000"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "scans",
          "target": "/data",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "database",
          "target": "/database",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=3).read()"
        ],
        "timeout": "5s",
        "interval": "30s",
        "retries": 3
      },
      "platform": "linux/amd64",
      "pull_policy": "never",
      "build": {
        "context": ".",
        "dockerfile": "docker/Dockerfile",
        "target": "app",
        "args": {
          "ODYSAFE_UID": "1000",
          "ODYSAFE_GID": "1000"
        }
      }
    },
    "capture-controller": {
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "cpus": 2,
      "command": null,
      "entrypoint": [
        "python",
        "-m",
        "app.orchestration.controller"
      ],
      "environment": {
        "ODYSAFE_ALLOWED_ORIGINS": "http://fixture-server:8000",
        "ODYSAFE_CONTROLLER_TOKEN": "${ODYSAFE_INSTALL_TOKEN:?Set ODYSAFE_INSTALL_TOKEN in your configuration file}",
        "ODYSAFE_DATA_DIR": "/data",
        "ODYSAFE_PUBLIC_CAPTURE": "true"
      },
      "image": "odysafe-source-interactive:0.1.0",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "2621440000",
      "networks": {
        "capture-control": null,
        "capture-test": null
      },
      "pids_limit": 256,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true",
        "apparmor=docker-default"
      ],
      "shm_size": "536870912",
      "stop_grace_period": "45s",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=256m",
        "/home/odysafe:rw,nosuid,nodev,size=64m,uid=1000,gid=1000",
        "/run:rw,nosuid,nodev,size=64m,uid=1000,gid=1000"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "scans",
          "target": "/data",
          "volume": {}
        }
      ],
      "depends_on": {
        "fixture-server": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "platform": "linux/amd64",
      "pull_policy": "never",
      "build": {
        "context": ".",
        "dockerfile": "docker/Dockerfile",
        "target": "interactive",
        "args": {
          "ODYSAFE_UID": "1000",
          "ODYSAFE_GID": "1000"
        }
      }
    },
    "capture-controller-internet": {
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "cpus": 2,
      "command": null,
      "entrypoint": [
        "python",
        "-m",
        "app.orchestration.controller"
      ],
      "environment": {
        "ODYSAFE_ALLOWED_ORIGINS": "http://fixture-server:8000",
        "ODYSAFE_CONTROLLER_TOKEN": "${ODYSAFE_INSTALL_TOKEN:?Set ODYSAFE_INSTALL_TOKEN in your configuration file}",
        "ODYSAFE_DATA_DIR": "/data",
        "ODYSAFE_INTERNET_PROXY": "http://internet-proxy:3128",
        "ODYSAFE_PUBLIC_CAPTURE": "true"
      },
      "image": "odysafe-source-interactive:0.1.0",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "2621440000",
      "networks": {
        "capture-control-internet": null,
        "capture-internet": null
      },
      "pids_limit": 256,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true",
        "apparmor=docker-default"
      ],
      "shm_size": "536870912",
      "stop_grace_period": "45s",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=256m",
        "/home/odysafe:rw,nosuid,nodev,size=64m,uid=1000,gid=1000",
        "/run:rw,nosuid,nodev,size=64m,uid=1000,gid=1000"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "scans",
          "target": "/data",
          "volume": {}
        }
      ],
      "depends_on": {
        "internet-proxy": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "platform": "linux/amd64",
      "pull_policy": "never",
      "build": {
        "context": ".",
        "dockerfile": "docker/Dockerfile",
        "target": "interactive",
        "args": {
          "ODYSAFE_UID": "1000",
          "ODYSAFE_GID": "1000"
        }
      }
    },
    "certificate-init": {
      "cap_add": [
        "CHOWN"
      ],
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "python",
        "/srv/certificate.py"
      ],
      "entrypoint": null,
      "environment": {
        "ODYSAFE_GID": "1000",
        "ODYSAFE_UID": "1000"
      },
      "image": "odysafe-source-gateway:0.1.0",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "network_mode": "none",
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "0:1000",
      "volumes": [
        {
          "type": "volume",
          "source": "certificates",
          "target": "/certificates",
          "volume": {}
        }
      ],
      "platform": "linux/amd64",
      "pull_policy": "never",
      "build": {
        "context": ".",
        "dockerfile": "docker/Dockerfile",
        "target": "xpra-gateway",
        "args": {
          "ODYSAFE_UID": "1000",
          "ODYSAFE_GID": "1000"
        }
      }
    },
    "certificate-maintenance": {
      "restart": "unless-stopped",
      "cap_add": [
        "CHOWN"
      ],
      "cap_drop": [
        "ALL"
      ],
      "cpus": 0.1,
      "command": [
