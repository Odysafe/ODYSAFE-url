      ],
      "entrypoint": null,
      "environment": {
        "ODYSAFE_BACKUP_DIR": "/backups",
        "ODYSAFE_DB_PATH": "/database/odysafe.db"
      },
      "image": "odysafe-source-app:0.1.0",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
