        "timeout": "5s",
        "interval": "1m0s",
        "retries": 3,
        "start_period": "2m0s"
      },
      "platform": "linux/amd64",
      "pull_policy": "never",
      "build": {
        "context": ".",
        "dockerfile": "docker/Dockerfile",
        "target": "app",
        "args": {
          "ODYSAFE_UID": "1000",
          "ODYSAFE_GID": "1000"
        }
      }
    },
